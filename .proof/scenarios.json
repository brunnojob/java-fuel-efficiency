{
  "repository": "brunnojob/java-fuel-efficiency",
  "inputs": [
    ".proof/scenarios.json",
    ".proof/demo.py"
  ],
  "cases": [
    {
      "name": "javac -Xlint:all -Werror FuelLog.java",
      "argv": [
        "bash",
        "-e",
        "-o",
        "pipefail",
        "-c",
        "javac -Xlint:all -Werror FuelLog.java"
      ],
      "timeout": 900,
      "display": false
    },
    {
      "name": "python -m unittest discover -v -s tests",
      "argv": [
        "bash",
        "-e",
        "-o",
        "pipefail",
        "-c",
        "python -m unittest discover -v -s tests"
      ],
      "timeout": 900,
      "display": true
    },
    {
      "name": "Account partial refueling and reject a regressed odometer",
      "argv": [
        "python",
        ".proof/demo.py"
      ],
      "contains": [
        "\"regressed_reading_rejected\": true"
      ],
      "timeout": 120
    }
  ]
}
